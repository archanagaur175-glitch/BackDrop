<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BackDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\BackDrop.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackDrop.Core\BackDrop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled default loop; extra user loops live under %LocalAppData%\BackDrop -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged apps resolve ms-appx:/// XAML through MRT Core, which reads the app's
       resources.pri. dotnet publish for self-contained/unpackaged builds drops the PRI
       (WindowsAppSDK #3451) — without it every Window/UserControl load fails with
       E_XAMLPARSEFAILED (0x802B000A). MakePri emits it into the intermediate bin dir;
       copy it into the publish dir when present. -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <!-- MakePri may emit resources.pri into the intermediate dir, the output dir, or
         the base output dir depending on SDK version — probe all likely locations. -->
    <ItemGroup>
      <_BackDropPri Include="$(IntermediateOutputPath)resources.pri"
                    Condition="Exists('$(IntermediateOutputPath)resources.pri')" />
      <_BackDropPri Include="$(OutputPath)resources.pri"
                    Condition="Exists('$(OutputPath)resources.pri')" />
      <_BackDropPri Include="$(BaseOutputPath)resources.pri"
                    Condition="Exists('$(BaseOutputPath)resources.pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BackDropPri)"
          DestinationFolder="$(PublishDir)"
          Condition="'@(_BackDropPri)' != ''" />
  </Target>

</Project>
