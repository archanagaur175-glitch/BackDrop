<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BackDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\BackDrop.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackDrop.Core\BackDrop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled default loop; extra user loops live under %LocalAppData%\BackDrop -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged apps resolve ms-appx:/// XAML through MRT Core, which reads the app's
       PRI file next to the executable. dotnet publish for self-contained/unpackaged
       builds drops the app PRI (WindowsAppSDK #3451) — without it every Window/
       UserControl load fails with E_XAMLPARSEFAILED (0x802B000A). MakePri emits the
       PRI into the intermediate/output dirs named $(AssemblyName).pri (older SDKs:
       resources.pri); probe both names in all locations and copy into the publish dir. -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_BackDropPri Include="$(IntermediateOutputPath)$(AssemblyName).pri"
                    Condition="Exists('$(IntermediateOutputPath)$(AssemblyName).pri')" />
      <_BackDropPri Include="$(IntermediateOutputPath)resources.pri"
                    Condition="Exists('$(IntermediateOutputPath)resources.pri')" />
      <_BackDropPri Include="$(OutputPath)$(AssemblyName).pri"
                    Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
      <_BackDropPri Include="$(OutputPath)resources.pri"
                    Condition="Exists('$(OutputPath)resources.pri')" />
      <_BackDropPri Include="$(BaseOutputPath)$(AssemblyName).pri"
                    Condition="Exists('$(BaseOutputPath)$(AssemblyName).pri')" />
      <_BackDropPri Include="$(BaseOutputPath)resources.pri"
                    Condition="Exists('$(BaseOutputPath)resources.pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BackDropPri)"
          DestinationFolder="$(PublishDir)"
          Condition="'@(_BackDropPri)' != ''" />
    <!-- Belt-and-suspenders: some MRT Core versions probe for the classic resources.pri
         name even when the module PRI is assembly-named. Emit both when available. -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
    <Copy SourceFiles="$(IntermediateOutputPath)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          Condition="!Exists('$(OutputPath)$(AssemblyName).pri') And Exists('$(IntermediateOutputPath)$(AssemblyName).pri')" />
    <Warning Text="BackDrop: app PRI file not found in any expected location; unpackaged XAML load may fail with 0x802B000A."
             Condition="'@(_BackDropPri)' == ''" />
  </Target>

</Project>
