<UserControl
    x:Class="BackDrop.App.Controls.VignetteOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Grid x:Name="VignetteRoot">
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Offset="0.55" Color="Transparent" />
                <GradientStop Offset="1.0" Color="#D0000000" />
            </RadialGradientBrush>
        </Grid.Background>
    </Grid>

</UserControl>
