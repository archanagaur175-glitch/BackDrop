<UserControl
    x:Class="BackDrop.App.Controls.AcrylicPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Padding="22,18"
            BorderThickness="1"
            BorderBrush="{StaticResource CardStrokeBrush}">
        <Border.Background>
            <!-- WinUI 3 AcrylicBrush has no BackgroundSource (UWP-only); it always samples the host backdrop. -->
            <AcrylicBrush TintColor="#FF1E222C"
                          TintOpacity="0.55"
                          FallbackColor="#FF1E222C" />
        </Border.Background>
        <ContentPresenter x:Name="ContentHost" />
    </Border>

</UserControl>
