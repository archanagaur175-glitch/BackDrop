<ContentControl
    x:Class="BackDrop.App.Controls.AcrylicPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentControl.Template>
        <ControlTemplate TargetType="ContentControl">
            <Border CornerRadius="12"
                    Padding="22,18"
                    BorderThickness="1"
                    BorderBrush="{StaticResource CardStrokeBrush}"
                    Background="{StaticResource SettingsCardBrush}">
                <!-- The ContentPresenter auto-binds to the templated parent's Content
                     (same mechanism as Button) — no manual content forwarding, which
                     previously double-assigned the child and threw E_INVALIDARG. -->
                <ContentPresenter />
            </Border>
        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
