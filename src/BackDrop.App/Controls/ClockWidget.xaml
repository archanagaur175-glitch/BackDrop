<UserControl
    x:Class="BackDrop.App.Controls.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="ClockPanel" Spacing="4">
        <TextBlock x:Name="ClockText" Style="{StaticResource ClockTextStyle}" />
        <TextBlock x:Name="DateText" Style="{StaticResource DateTextStyle}" />
    </StackPanel>

</UserControl>
