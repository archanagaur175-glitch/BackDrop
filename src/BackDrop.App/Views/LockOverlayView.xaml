<UserControl
    x:Class="BackDrop.App.Views.LockOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BackDrop.App.Controls">

    <Grid x:Name="RootGrid"
          Background="Black"
          IsTabStop="True"
          KeyDown="RootGrid_KeyDown"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved">

        <MediaPlayerElement x:Name="MediaElement"
                            AreTransportControlsEnabled="False" />

        <controls:VignetteOverlay x:Name="Vignette" />

        <controls:ClockWidget x:Name="Clock" />

        <!-- Dismiss hint -->
        <TextBlock x:Name="HintText"
                   Style="{StaticResource HintTextStyle}"
                   Text="Move the mouse or press any key to dismiss"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,48"
                   IsHitTestVisible="False" />

        <!-- Optional PIN gate (opt-in, local-only) -->
        <Border x:Name="PinPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource PinPanelBrush}"
                CornerRadius="16"
                Padding="28,24"
                BorderThickness="1"
                BorderBrush="{StaticResource CardStrokeBrush}">
            <StackPanel Spacing="14" Width="260">
                <TextBlock Text="Enter PIN to unlock"
                           Style="{StaticResource SectionTitleStyle}"
                           HorizontalAlignment="Center" />
                <PasswordBox x:Name="PinBox"
                             PlaceholderText="PIN"
                             HorizontalAlignment="Stretch"
                             KeyDown="PinBox_KeyDown" />
                <TextBlock x:Name="PinErrorText"
                           Text="Incorrect PIN — try again."
                           Style="{StaticResource HintTextStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="Collapsed" />
                <Button Content="Unlock"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="UnlockButton_Click" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
