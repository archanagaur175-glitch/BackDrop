<UserControl
    x:Class="BackDrop.App.Views.MediaManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">

        <TextBlock Text="{x:Bind ViewModel.ActiveVideoLabel, Mode=OneWay}"
                   Style="{StaticResource BodyTextStyle}" />

        <ListView x:Name="MediaList"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  MaxHeight="220">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="{Binding DisplaySize}"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Import video…" Click="Import_Click" />
            <Button Content="Use as active loop" Click="SetActive_Click" />
            <Button Content="Remove" Click="Remove_Click" />
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Style="{StaticResource HintTextStyle}"
                   TextWrapping="Wrap" />

    </StackPanel>

</UserControl>
