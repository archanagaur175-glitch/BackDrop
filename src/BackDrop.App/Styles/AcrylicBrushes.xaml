<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF101218" />

    <!-- Settings card surface. Solid for now: an inline AcrylicBrush created at XAML
         parse time was implicated in the startup XamlParseException. Acrylic will be
         re-introduced in code-behind (post-activation, safe timing) once the app
         launches reliably. -->
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF1E222C" />

    <SolidColorBrush x:Key="CardStrokeBrush" Color="#26FFFFFF" />

    <SolidColorBrush x:Key="PinPanelBrush" Color="#E6101218" />

</ResourceDictionary>
