<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flipped to true only after the codebase is proven green (post-green hardening). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Generate + honor per-project lock files. First CI run generates them;
         they are then committed and CI moves to --locked-mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
